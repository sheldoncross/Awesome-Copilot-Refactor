{
  "name": "prompt-library",
  "displayName": "Prompt Library",
  "publisher": "timheuer",
  "author": {
    "name": "Tim Heuer"
  },
  "bugs": {
    "url": "https://github.com/timheuer/vscode-awesome-copilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timheuer/vscode-awesome-copilot"
  },
  "qna": "https://github.com/timheuer/vscode-awesome-copilot/issues",
  "homepage": "https://github.com/timheuer/vscode-awesome-copilot",
  "description": "Browse and download instructions, prompts, chat modes, and agents from community repositories",
  "version": "0.0.0-placeholder",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:promptLibraryExplorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptLibrary",
          "title": "Prompt Library",
          "icon": "resources/prompt-library-dark.svg"
        }
      ]
    },
    "configuration": {
      "title": "Prompt Library",
      "properties": {
        "prompt-library.repositories": {
          "type": "array",
          "title": "Repositories",
          "description": "Configure GitHub repositories as content sources",
          "default": [
            {
              "owner": "github",
              "repo": "awesome-copilot",
              "label": "Awesome Copilot"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "description": "Repository owner"
              },
              "repo": {
                "type": "string",
                "description": "Repository name"
              },
              "label": {
                "type": "string",
                "description": "Display name (optional)"
              },
              "baseUrl": {
                "type": "string",
                "description": "GitHub Enterprise URL (optional)"
              }
            }
          },
          "scope": "application"
        },
        "prompt-library.enterpriseToken": {
          "type": "string",
          "default": "",
          "description": "Personal Access Token for GitHub Enterprise authentication",
          "scope": "application",
          "markdownDescription": "Required permissions: `repo`, `read:org`, `read:user`  \nCreate at: your-github-enterprise.com/settings/tokens"
        },
        "prompt-library.cacheTimeout": {
          "type": "number",
          "default": 3600000,
          "minimum": 60000,
          "maximum": 86400000,
          "description": "Cache duration in milliseconds (default: 1 hour)",
          "scope": "application"
        },
        "prompt-library.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh content on VS Code startup",
          "scope": "application"
        },
        "prompt-library.showTreeView": {
          "type": "boolean",
          "default": true,
          "description": "Show/hide the Prompt Library tree view in the Explorer panel",
          "scope": "application"
        },
        "prompt-library.allowInsecureEnterpriseCerts": {
          "type": "boolean",
          "default": false,
          "description": "⚠️ SECURITY WARNING: Allow insecure certificates for Enterprise GitHub servers. Only enable this for trusted enterprise environments with self-signed certificates.",
          "scope": "application",
          "markdownDescription": "**⚠️ SECURITY WARNING:** This setting disables TLS certificate validation for Enterprise GitHub servers only. Only enable for trusted enterprise environments with self-signed certificates.  \n\n**Default: `false` (secure)**  \n\n**Note:** If you're getting certificate errors with enterprise GitHub, enable this temporarily to add your repository, then you can disable it again for better security."
        },
        "prompt-library.enableGithubAuth": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitHub authentication via VS Code to increase rate limits from 60 to 5,000 requests per hour",
          "scope": "application",
          "title": "Enable GitHub Authentication",
          "markdownDescription": "**Enable GitHub Authentication**  \n\nWhen enabled, the extension will use VS Code's GitHub authentication to access the API with higher rate limits:  \n- **Authenticated:** 5,000 requests/hour  \n- **Unauthenticated:** 60 requests/hour  \n\nThe extension will prompt you to sign in when needed."
        },
        "prompt-library.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "enumDescriptions": [
            "Only show error messages",
            "Show warnings and errors",
            "Show informational messages, warnings, and errors",
            "Show debug information and all above",
            "Show all logging including trace information"
          ],
          "default": "info",
          "description": "Set the logging level for the Prompt Library extension",
          "scope": "application",
          "title": "Log Level"
        },
        "prompt-library.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check for updates to downloaded items and notify when newer versions are available",
          "scope": "application"
        }
      }
    },
    "commands": [
      {
        "command": "prompt-library.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "prompt-library.downloadItem",
        "title": "Download",
        "icon": "$(cloud-download)"
      },
      {
        "command": "prompt-library.previewItem",
        "title": "Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "prompt-library.manageSources",
        "title": "Prompt Library: Manage Sources",
        "icon": "$(repo)"
      },
      {
        "command": "prompt-library.removeRepo",
        "title": "Remove Repository",
        "icon": "$(trash)"
      },
      {
        "command": "prompt-library.refreshRepo",
        "title": "Refresh Repository",
        "icon": "$(refresh)"
      },
      {
        "command": "prompt-library.configureEnterpriseToken",
        "title": "Prompt Library: Configure Enterprise Token",
        "icon": "$(key)"
      },
      {
        "command": "prompt-library.clearEnterpriseToken",
        "title": "Prompt Library: Clear Enterprise Token",
        "icon": "$(trash)"
      },
      {
        "command": "prompt-library.toggleTreeView",
        "title": "Prompt Library: Toggle Tree View",
        "icon": "$(eye)"
      },
      {
        "command": "prompt-library.showTreeView",
        "title": "Prompt Library: Show Tree View",
        "icon": "$(eye)"
      },
      {
        "command": "prompt-library.hideTreeView",
        "title": "Prompt Library: Hide Tree View",
        "icon": "$(eye-closed)"
      },
      {
        "command": "prompt-library.signInToGitHub",
        "title": "Prompt Library: Sign in to GitHub",
        "icon": "$(github)"
      },
      {
        "command": "prompt-library.signOutFromGitHub",
        "title": "Prompt Library: Sign out from GitHub",
        "icon": "$(sign-out)"
      },
      {
        "command": "prompt-library.openRepoInBrowser",
        "title": "Open Repository in Browser",
        "icon": "$(github)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "promptLibraryExplorer",
          "name": "Prompt Library",
          "icon": "$(robot)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptLibraryExplorer",
        "contents": "No repositories configured.\n[Manage Sources](command:prompt-library.manageSources)\nBrowse and download instructions, prompts, chat modes, and agents from community repositories.",
        "when": "config.prompt-library.showTreeView"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prompt-library.refresh",
          "when": "view == promptLibraryExplorer",
          "group": "navigation@2"
        },
        {
          "command": "prompt-library.manageSources",
          "when": "view == promptLibraryExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "prompt-library.downloadItem",
          "when": "view == promptLibraryExplorer && viewItem == copilotFile",
          "group": "inline@1"
        },
        {
          "command": "prompt-library.previewItem",
          "when": "view == promptLibraryExplorer && viewItem == copilotFile",
          "group": "inline@2"
        },
        {
          "command": "prompt-library.openRepoInBrowser",
          "when": "view == promptLibraryExplorer && viewItem == copilotRepo",
          "group": "inline@1"
        },
        {
          "command": "prompt-library.refreshRepo",
          "when": "view == promptLibraryExplorer && viewItem == copilotRepo",
          "group": "inline@2"
        },
        {
          "command": "prompt-library.removeRepo",
          "when": "view == promptLibraryExplorer && viewItem == copilotRepo",
          "group": "inline@3"
        },
        {
          "command": "prompt-library.removeRepo",
          "when": "view == promptLibraryExplorer && viewItem == copilotRepo",
          "group": "1_repo@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test 'out/test/**/*.test.js'",
    "test:watch": "npm-run-all -p watch:tsc watch-tests",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "nerdbank-gitversioning": "^3.6.133",
    "npm-run-all": "^4.1.5",
    "sinon": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@timheuer/vscode-ext-logger": "^0.1.35",
    "@vscode/vsce": "^3.7.1",
    "axios": "^1.11.0"
  }
}
